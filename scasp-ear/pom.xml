<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.scasp</groupId>
        <artifactId>scasp-platform</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>scasp-application</artifactId>
    <packaging>ear</packaging>
    <name>SCASP Enterprise Application</name>

    <dependencies>
        <!-- EJB application module -->
        <dependency>
            <groupId>com.scasp</groupId>
            <artifactId>enterprise-services</artifactId>
            <version>${project.version}</version>
            <type>ejb</type>
        </dependency>

        <!-- Shared application libraries -->
        <dependency>
            <groupId>com.scasp</groupId>
            <artifactId>core-domain</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.scasp</groupId>
            <artifactId>web-application</artifactId>
            <version>${project.version}</version>
            <type>war</type>
        </dependency>

        <dependency>
            <groupId>com.scasp</groupId>
            <artifactId>persistence-jdbc</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>SCASP</finalName>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-ear-plugin</artifactId>
                <version>3.3.0</version>

                <configuration>
                    <version>10</version>
                    <defaultLibBundleDir>lib</defaultLibBundleDir>
                    <generateApplicationXml>true</generateApplicationXml>

                    <modules>
                        <webModule>
                            <groupId>com.scasp</groupId>
                            <artifactId>web-application</artifactId>
                            <contextRoot>/scasp</contextRoot>
                        </webModule>
                    </modules>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>